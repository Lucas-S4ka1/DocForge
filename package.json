{
  "name": "docforge",
  "productName": "DocForge",
  "version": "1.0.0",
  "description": "Dokument- und Bewerbungs-Builder – visuell und per Text-Prompt. Offline, lokal, deins.",
  "author": "P.J. Works",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/exo-2": "^5.2.6",
    "@fontsource/inter": "^5.2.6",
    "@fontsource/rajdhani": "^5.2.6",
    "i18next": "^25.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
